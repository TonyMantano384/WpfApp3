<Window x:Class="WpfApp3.Views.ProductViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр товара" Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/chudobuv.png">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Column="0" x:Name="ImgProduct" Stretch="Uniform"
               Width="300" Height="300" Margin="10"/>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock x:Name="TbName" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="TbProduction" FontSize="14" Foreground="Gray" Margin="0,4"/>
            <TextBlock x:Name="TbCategory" FontSize="14" Foreground="Gray"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock x:Name="TbPriceDisc" FontSize="22"
                           FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="TbPriceOld" FontSize="14" Foreground="Gray"
                           TextDecorations="Strikethrough"
                           Margin="10,8,0,0" VerticalAlignment="Bottom"/>
            </StackPanel>

            <TextBlock Text="Состав:" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <TextBlock x:Name="TbMaterial" TextWrapping="Wrap"/>

            <TextBlock Text="Описание:" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <TextBlock x:Name="TbDescription" TextWrapping="Wrap"/>

            <TextBlock Text="Доступные размеры:" FontWeight="SemiBold" Margin="0,15,0,5"/>
            <ComboBox x:Name="CbSize" Width="250" HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TbQuantity" Width="80" Height="26" Text="1"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{StaticResource SecondaryBg}" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Добавить в заказ" Width="160" Height="34"
                        Style="{StaticResource AccentButton}"
                        Click="BtnAddToCart_Click"/>
                <Button Content="Оформить заказ" Width="160" Height="34" Margin="10,0"
                        Style="{StaticResource AccentButton}"
                        Click="BtnCheckout_Click"/>
                <Button Content="Закрыть" Width="120" Height="34"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>