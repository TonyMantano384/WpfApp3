<Window x:Class="WpfApp3.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование заказа" Height="560" Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/chudobuv.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TbHeader" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Дата заказа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker x:Name="DpDate" Width="180"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="DgItems" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Модель" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="100"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Удалить позицию" Width="160" Height="34"
                    Click="BtnDeleteItem_Click"/>
            <Button Content="Сохранить" Width="130" Height="34" Margin="10,0"
                    Style="{StaticResource AccentButton}"
                    Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="34"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>