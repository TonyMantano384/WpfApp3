<Window x:Class="WpfApp3.Views.OrderCompositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав заказа" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/chudobuv.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TbHeader" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="DgItems" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Модель" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Производство" Binding="{Binding Production}" Width="180"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена за ед."
                                    Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="130"/>
                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Sum, StringFormat={}{0:C}}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{StaticResource SecondaryBg}"
                Padding="10" Margin="0,10,0,0">
            <TextBlock x:Name="TbTotal" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Right"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Удалить позицию" Width="160" Height="34"
                    Style="{StaticResource AccentButton}"
                    Click="BtnDeleteItem_Click"/>
            <Button Content="Закрыть" Width="120" Height="34" Margin="10,0,0,0"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>