<Window x:Class="WpfApp3.MainWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ОбувьМир — Каталог" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/chudobuv.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBg}" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/chudobuv.png" Width="40" Height="40" Margin="5"/>
                    <TextBlock Text="ОбувьМир" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TbUserFio" FontWeight="SemiBold"
                               Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnOrders" Content="Заказы"
                            Style="{StaticResource AccentButton}"
                            Visibility="Collapsed" Click="BtnOrders_Click" Margin="0,0,5,0"/>
                    <Button x:Name="BtnLogout" Content="Выйти"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SecondaryBg}"
                Padding="10" Margin="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="CbCategory" Width="200" SelectedIndex="0"
                          SelectionChanged="CbCategory_SelectionChanged" Margin="0,0,15,0"/>

                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="CbSort" Width="220" SelectedIndex="0"
                          SelectionChanged="CbSort_SelectionChanged" Margin="0,0,15,0">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="Цена: по возрастанию"/>
                    <ComboBoxItem Content="Цена: по убыванию"/>
                </ComboBox>

                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="TbSearch" Width="300" Height="26"
                         TextChanged="TbSearch_TextChanged"
                         ToolTip="Введите наименование или описание товара"/>
            </StackPanel>
        </Border>

        <!-- Заголовок списка -->
        <TextBlock Grid.Row="2" Text="Каталог моделей обуви" FontSize="18"
                   FontWeight="Bold" Margin="10,8,0,4"/>

        <!-- Список товаров -->
        <ListView Grid.Row="3" x:Name="LvProducts" Margin="10"
                  SelectionChanged="LvProducts_SelectionChanged"
            HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1"
                            Background="{Binding RowBackground}">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{Binding ImagePath}"
                                   Width="100" Height="80" Stretch="Uniform"/>

                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock FontWeight="Bold">
                                    <Run Text="{Binding ProductionName}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding CategoryName}" FontSize="12"/>
                                <TextBlock Text="{Binding QuantityText}" FontSize="12"/>
                                <TextBlock Text="{Binding Material}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PriceWithDiscount, StringFormat={}{0:C}}"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding OldPrice, StringFormat={}{0:C}}"
                                           TextDecorations="Strikethrough" FontSize="11"
                                           Foreground="Gray" HorizontalAlignment="Right"
                                           Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
